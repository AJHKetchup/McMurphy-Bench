{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcmurphy-bench.local/schema.json",
  "title": "McMurphy-Bench Records",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/prompt_instance"
    },
    {
      "$ref": "#/$defs/model_response"
    },
    {
      "$ref": "#/$defs/judgment"
    },
    {
      "$ref": "#/$defs/run_manifest"
    }
  ],
  "$defs": {
    "risk_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "domain": {
      "type": "string",
      "enum": [
        "medicine_health",
        "biology",
        "chemistry",
        "cybersecurity",
        "ai_research_ml",
        "law_finance",
        "politics_public_figures",
        "sex_relationships",
        "self_harm_adjacent",
        "fiction_history_metaphor"
      ]
    },
    "release_class": {
      "type": "string",
      "enum": [
        "public",
        "restricted"
      ]
    },
    "refusal_class": {
      "type": "string",
      "enum": [
        "ANSWERED",
        "HARD_REFUSAL",
        "SOFT_REFUSAL",
        "OVERCAUTION_DEGRADATION",
        "BOUNDED_SAFE_HELP",
        "CLARIFIED"
      ]
    },
    "fallback_status": {
      "type": "string",
      "enum": [
        "NONE",
        "TRANSPARENT_FALLBACK",
        "SUSPECTED_HIDDEN_DEGRADE",
        "TOOL_DISABLED"
      ]
    },
    "degradation_evidence_class": {
      "type": "string",
      "enum": [
        "CONFIRMED_PROVIDER_METADATA",
        "DISCLOSED_TO_USER",
        "SUSPECTED_BEHAVIORAL",
        "UNSUPPORTED"
      ]
    },
    "score_0_4": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "timestamp": {
      "type": "string"
    },
    "judgment_status": {
      "type": "string",
      "enum": [
        "template",
        "completed"
      ]
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "created_at_utc",
        "prompt_id",
        "family_id",
        "domain",
        "risk_tier",
        "variant",
        "release",
        "prompt",
        "prompt_hash",
        "public_prompt_hash",
        "restricted_prompt_hash",
        "expected_behavior",
        "unsafe_control"
      ],
      "properties": {
        "record_type": {
          "const": "prompt_instance"
        },
        "schema_version": {
          "type": "string"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "prompt_id": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "risk_tier": {
          "$ref": "#/$defs/risk_tier"
        },
        "variant": {
          "type": "string"
        },
        "release": {
          "$ref": "#/$defs/release_class"
        },
        "task_intent": {
          "type": "string"
        },
        "underlying_capability": {
          "type": "string"
        },
        "safety_trigger_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benign_user_intent": {
          "type": "string"
        },
        "expected_safe_answer_type": {
          "type": "string"
        },
        "forbidden_detail_type": {
          "type": "string"
        },
        "objective_check_possible": {
          "type": "boolean"
        },
        "jurisdiction_required": {
          "type": "boolean"
        },
        "expert_required_for_validation": {
          "type": "boolean"
        },
        "checks": {
          "type": "object"
        },
        "prompt": {
          "type": "string"
        },
        "public_summary": {
          "type": "string"
        },
        "expected_behavior": {
          "type": "string"
        },
        "unsafe_control": {
          "type": "boolean"
        },
        "prompt_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "public_prompt_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "restricted_prompt_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256_hex"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "model_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "created_at_utc",
        "run_id",
        "model",
        "provider",
        "model_version",
        "mode",
        "prompt_id",
        "family_id",
        "domain",
        "risk_tier",
        "variant",
        "prompt_hash",
        "response_hash",
        "system_prompt_hash",
        "temperature",
        "top_p",
        "max_tokens",
        "timestamp_utc",
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "raw_response",
        "visible_refusal",
        "visible_fallback",
        "fallback_model",
        "provider_metadata"
      ],
      "properties": {
        "record_type": {
          "const": "model_response"
        },
        "schema_version": {
          "type": "string"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "run_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "product",
            "controlled_api",
            "capability_reference"
          ]
        },
        "prompt_id": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "risk_tier": {
          "$ref": "#/$defs/risk_tier"
        },
        "variant": {
          "type": "string"
        },
        "prompt_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "response_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "system_prompt_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256_hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timestamp_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raw_response": {
          "type": "string"
        },
        "visible_refusal": {
          "type": "boolean"
        },
        "visible_fallback": {
          "type": "boolean"
        },
        "fallback_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_metadata": {
          "type": "object"
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "judgment_status",
        "created_at_utc",
        "run_id",
        "model",
        "prompt_id",
        "family_id",
        "domain",
        "risk_tier",
        "variant",
        "prompt_hash",
        "response_hash",
        "judge_id",
        "judge_version",
        "answerable",
        "is_harmful_control",
        "usefulness_score",
        "unsafe_score",
        "directness_score",
        "specificity_score",
        "completeness_score",
        "correctness_score",
        "boundary_calibration_score",
        "disclaimer_load_score",
        "refusal_class",
        "fallback_status",
        "clarification_success",
        "degradation_evidence_class",
        "rationale"
      ],
      "properties": {
        "record_type": {
          "const": "judgment"
        },
        "schema_version": {
          "type": "string"
        },
        "judgment_status": {
          "$ref": "#/$defs/judgment_status"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "run_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_id": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "risk_tier": {
          "$ref": "#/$defs/risk_tier"
        },
        "variant": {
          "type": "string"
        },
        "prompt_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "response_hash": {
          "$ref": "#/$defs/sha256_hex"
        },
        "judge_id": {
          "type": "string"
        },
        "judge_version": {
          "type": "string"
        },
        "answerable": {
          "type": "boolean"
        },
        "is_harmful_control": {
          "type": "boolean"
        },
        "usefulness_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "unsafe_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "directness_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "specificity_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "completeness_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "correctness_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "boundary_calibration_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "disclaimer_load_score": {
          "$ref": "#/$defs/score_0_4"
        },
        "refusal_class": {
          "$ref": "#/$defs/refusal_class"
        },
        "fallback_status": {
          "$ref": "#/$defs/fallback_status"
        },
        "clarification_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "degradation_evidence_class": {
          "$ref": "#/$defs/degradation_evidence_class"
        },
        "turn_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raw_response": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "run_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "run_id",
        "created_at_utc",
        "benchmark_version",
        "package_version",
        "prompt_set",
        "prompt_set_is_repo_relative",
        "prompt_set_sha256",
        "models",
        "evaluation_mode",
        "judge",
        "audit",
        "scoring_weights",
        "notes"
      ],
      "properties": {
        "record_type": {
          "const": "run_manifest"
        },
        "schema_version": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "created_at_utc": {
          "$ref": "#/$defs/timestamp"
        },
        "benchmark_version": {
          "type": "string"
        },
        "package_version": {
          "type": "string"
        },
        "prompt_set": {
          "type": "string"
        },
        "prompt_set_is_repo_relative": {
          "type": "boolean"
        },
        "prompt_set_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "models": {
          "type": "array"
        },
        "evaluation_mode": {
          "type": "string"
        },
        "judge": {
          "type": "object"
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_rate",
            "seed"
          ],
          "properties": {
            "sample_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "scoring_weights": {
          "type": "object"
        },
        "estimated_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pricing_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
